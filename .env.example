# Vyoman Interviewer — environment variables
#
# This file lists every environment variable implied by the stack described
# in docs/BUILD_SPEC.md Part 2. NONE of the values below are real — they are
# placeholders. Copy this file to .env.local (web) / .env (engine) and fill
# in real values from each provider's dashboard. Never commit the filled-in
# file (see .gitignore).

# ---------------------------------------------------------------------------
# Supabase (Postgres database, auth, storage)
# Get these from: https://app.supabase.com -> your project -> Settings -> API
# ---------------------------------------------------------------------------

# Public project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public "anon" key, safe to expose to the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret service-role key — server-side only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string, for migrations/scripts. Settings -> Database -> Connection string.
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Cloudflare R2 (object storage for audio/resume/report files)
# Get these from: Cloudflare dashboard -> R2 -> Manage R2 API Tokens
# ---------------------------------------------------------------------------

# Your Cloudflare account ID (dashboard URL or Account Home sidebar).
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API token access key ID.
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 API token secret access key.
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Name of the R2 bucket used by this project.
R2_BUCKET_NAME=vyoman-interviewer

# ---------------------------------------------------------------------------
# Upstash Redis (caching / rate limiting / queues)
# Get these from: https://console.upstash.com -> your database -> REST API
# ---------------------------------------------------------------------------

# REST API URL for the Upstash Redis database.
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io

# REST API token for the Upstash Redis database.
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ---------------------------------------------------------------------------
# Groq (fast LLM inference)
# Get this from: https://console.groq.com -> API Keys
# ---------------------------------------------------------------------------

GROQ_API_KEY=your-groq-api-key

# ---------------------------------------------------------------------------
# Sarvam (Indian-language speech/LLM APIs)
# Get this from: https://dashboard.sarvam.ai -> API Keys
# ---------------------------------------------------------------------------

SARVAM_API_KEY=your-sarvam-api-key

# ---------------------------------------------------------------------------
# Google Gemini (LLM)
# Get this from: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------

GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Resend (transactional email)
# Get this from: https://resend.com/api-keys
# ---------------------------------------------------------------------------

RESEND_API_KEY=your-resend-api-key

# ---------------------------------------------------------------------------
# Razorpay (payments — late phase, not needed until billing is built)
# Get these from: https://dashboard.razorpay.com -> Settings -> API Keys
# ---------------------------------------------------------------------------

# Razorpay key ID (late phase).
RAZORPAY_KEY_ID=your-razorpay-key-id

# Razorpay key secret (late phase). Never expose to the client.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ---------------------------------------------------------------------------
# Sentry (error monitoring)
# Get this from: https://sentry.io -> your project -> Settings -> Client Keys (DSN)
# ---------------------------------------------------------------------------

SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0

# ---------------------------------------------------------------------------
# PostHog (product analytics)
# Get these from: https://app.posthog.com -> Project Settings -> Project API Key
# ---------------------------------------------------------------------------

# Public PostHog project key, safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key

# PostHog ingestion host (use https://us.i.posthog.com or https://eu.i.posthog.com depending on your region).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Misc / cross-cutting
# ---------------------------------------------------------------------------

# Base URL the web app uses to reach the FastAPI engine service.
ENGINE_BASE_URL=http://localhost:8000

# Node environment for apps/web (development | production | test).
NODE_ENV=development

# Environment name for services/engine (development | staging | production).
ENVIRONMENT=development
